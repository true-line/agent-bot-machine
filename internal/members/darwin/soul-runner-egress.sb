(version 1)
; Installed launcher supplies the exact HQ admission and B relay sockets
; for this Soul start. R binds only its assigned Souls member socket.
(allow default)
(deny network*)
(allow network-outbound (remote unix-socket (path-literal (param "ADMISSION_SOCKET"))))
(allow network-outbound (remote unix-socket (path-literal (param "RELAY_SOCKET"))))
(allow network-bind (local unix-socket (path-literal (param "MEMBER_SOCKET"))))
