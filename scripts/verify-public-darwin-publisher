#!/usr/bin/env bash
# A positive match requires separate review of the entire public certificate DER.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
approved="$root/.github/macos-public-publisher-sha256"
refuse() { echo 'Public macOS publisher verification failed' >&2; exit 1; }
[[ -f "$approved" ]] && grep -Eq '^[0-9a-f]{64}$' "$approved" || refuse
[[ "$#" == 1 && "$1" == --configured ]] && exit 0
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
team=Z5DM34QS5U
if [[ "${1:-}" == --identity ]]; then
    [[ "$#" == 3 && "$3" == "$team" ]] || refuse
    # codesign selects identities by SHA-1. Link usable identities to the
    # approved SHA-256 of the same certificate in this release keychain.
    security find-identity -v -p codesigning "$2" 2>/dev/null |
        awk -F '"' -v suffix=" ($team)" '
            index($2, "Developer ID Application: ") == 1 &&
            substr($2, length($2) - length(suffix) + 1) == suffix { print $1 }
        ' |
        awk '{print toupper($2)}' > "$work/identities" || refuse
    identity="$(security find-certificate -a -Z "$2" 2>/dev/null |
        awk '
            FILENAME == ARGV[1] { pins[$0] = 1; next }
            FILENAME == ARGV[2] { usable[$0] = 1; next }
            /^SHA-256 hash: / { approved = (tolower($3) in pins); next }
            /^SHA-1 hash: / {
                id = toupper($3)
                if (approved && id in usable && !selected) { print id; selected = 1 }
                approved = 0
            }
        ' "$approved" "$work/identities" -)" || refuse
    [[ "$identity" =~ ^[0-9A-F]{40}$ ]] || refuse
    printf '%s\n' "$identity"
    exit 0
fi
[[ "$#" == 2 ]] || refuse
case "$1" in
    --tree) tree="$2" ;;
    --archive)
        tree="$work/binaries"
        mkdir "$tree"
        for name in managed-machine agent-bot-keyd; do
            tar -xOzf "$2" "$name" > "$tree/$name" 2>/dev/null || refuse
            chmod 0700 "$tree/$name"
        done ;;
    *) refuse ;;
esac
for name in managed-machine agent-bot-keyd; do
    if [[ "$name" == managed-machine ]]; then id=ai.true-line.agent-bot-machine
    else id=ai.true-line.agent-bot-keyd; fi
    bin="$tree/$name"
    requirement="anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] exists and certificate leaf[field.1.2.840.113635.100.6.1.13] exists and certificate leaf[subject.OU] = \"$team\" and identifier \"$id\""
    codesign --verify --strict "-R=$requirement" "$bin" >/dev/null 2>&1 || refuse
    prefix="$work/$name-cert"
    codesign -d --extract-certificates="$prefix" "$bin" >/dev/null 2>&1 || refuse
    [[ -s "${prefix}0" ]] || refuse
    digest="$(shasum -a 256 "${prefix}0" | awk '{print $1}')" || refuse
    [[ "$digest" =~ ^[0-9a-f]{64}$ ]] && grep -Fxq "$digest" "$approved" || refuse
done
