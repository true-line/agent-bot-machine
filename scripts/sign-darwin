#!/usr/bin/env bash
# Signs and notarizes the darwin/arm64 binary of a deterministic dist and
# writes a signed dist that `mm-release verify-signed` accepts. Runs only in
# the `sign` job of .github/workflows/sign.yml, inside the `release`
# environment, on a macOS runner.
#
#   scripts/sign-darwin <X.Y.Z> <unsigned-dist> <signed-dist>
#
# Environment:
#   SIGN_KEYCHAIN       keychain holding the Developer ID Application identity
#   NOTARY_KEY_PATH     App Store Connect API key (.p8)
#   NOTARY_KEY_ID       its Key ID
#   NOTARY_ISSUER_ID    its Issuer ID
set -euo pipefail

team="Z5DM34QS5U"
signing_id="ai.true-line.agent-bot-machine"

[[ $# -eq 3 ]] || { echo "usage: scripts/sign-darwin <X.Y.Z> <unsigned-dist> <signed-dist>" >&2; exit 2; }
version="$1" unsigned="$2" signed="$3"
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "Error: version must be X.Y.Z" >&2; exit 2; }
for v in SIGN_KEYCHAIN NOTARY_KEY_PATH NOTARY_KEY_ID NOTARY_ISSUER_ID; do
    [[ -n "${!v:-}" ]] || { echo "Error: $v is required" >&2; exit 2; }
done

root="$(cd "$(dirname "$0")/.." && pwd)"
work="$(mktemp -d "${RUNNER_TEMP:-${TMPDIR:-/tmp}}/sign-darwin.XXXXXX")"
trap 'rm -rf "$work"' EXIT
tree="$work/tree"
mkdir -p "$tree"

archive="managed-machine_${version}_darwin_arm64.tar.gz"
(cd "$root" && go run ./cmd/mm-release verify -dist "$unsigned")
tar -xzf "$unsigned/$archive" -C "$tree"

identity="$(security find-identity -v -p codesigning "$SIGN_KEYCHAIN" \
    | awk -v t="($team)" '/"Developer ID Application: / && index($0, t) { print $2; exit }')"
[[ "$identity" =~ ^[0-9A-F]{40}$ ]] || { echo "Error: no Developer ID Application identity for $team in $SIGN_KEYCHAIN" >&2; exit 1; }

codesign --force --timestamp --options runtime --keychain "$SIGN_KEYCHAIN" \
    -s "$identity" -i "$signing_id" "$tree/managed-machine"

codesign --verify --strict --verbose=2 "$tree/managed-machine"
details="$(codesign -dv --verbose=2 "$tree/managed-machine" 2>&1)"
grep -Fq "Authority=Developer ID Application: " <<<"$details"
grep -Fqx "TeamIdentifier=$team" <<<"$details"
grep -Fqx "Identifier=$signing_id" <<<"$details"
grep -Fq "flags=0x10000(runtime)" <<<"$details"

ditto -c -k "$tree/managed-machine" "$work/cli.zip"
result="$(xcrun notarytool submit "$work/cli.zip" --key "$NOTARY_KEY_PATH" --key-id "$NOTARY_KEY_ID" \
    --issuer "$NOTARY_ISSUER_ID" --wait --timeout 30m --output-format json)"
status="$(plutil -extract status raw -o - - <<<"$result")"
if [[ "$status" != "Accepted" ]]; then
    id="$(plutil -extract id raw -o - - <<<"$result" || true)"
    echo "Error: notarization of cli.zip returned '$status'" >&2
    [[ -n "$id" ]] && xcrun notarytool log "$id" --key "$NOTARY_KEY_PATH" --key-id "$NOTARY_KEY_ID" --issuer "$NOTARY_ISSUER_ID" >&2 || true
    rm -f "$NOTARY_KEY_PATH"
    exit 1
fi
rm -f "$NOTARY_KEY_PATH"

assessment=""
for attempt in 1 2 3 4 5; do
    assessment="$(spctl -a -t open --context context:primary-signature -vv "$tree/managed-machine" 2>&1 || true)"
    if grep -Fq "source=Notarized Developer ID" <<<"$assessment" && grep -Fq "($team)" <<<"$assessment"; then
        break
    fi
    [[ "$attempt" == 5 ]] && { echo "Error: Gatekeeper notarization check failed: $assessment" >&2; exit 1; }
    sleep 15
done

rm -rf "$signed"
(cd "$root" && go run ./cmd/mm-release repack -dist "$unsigned" -tree "$tree" -out "$signed")
(cd "$root" && go run ./cmd/mm-release verify-signed -unsigned "$unsigned" -signed "$signed" -team "$team")
